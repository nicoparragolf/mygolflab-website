{
  "functions": {
    "api/coach.js": {
      "maxDuration": 60
    },
    "api/pago-crear.js": {
      "maxDuration": 30
    },
    "api/pago-confirmar.js": {
      "maxDuration": 30
    },
    "api/pago-retorno.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "coachyard.golf"
        }
      ],
      "destination": "/es/coachhub/index.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.coachyard.golf"
        }
      ],
      "destination": "https://coachyard.golf/es/coachhub/index.html",
      "permanent": false
    }
  ]
}
